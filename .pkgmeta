# CurseForge / BigWigs packager configuration.
package-as: ItemLockForever

# The addon lives in ItemLockForever/ inside the repository; this moves its contents to the top of
# the package (and removes the then-empty inner folder).
move-folders:
  ItemLockForever/ItemLockForever: ItemLockForever

ignore:
  - tests
  - scripts
  - docs
  - stylua.toml

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
